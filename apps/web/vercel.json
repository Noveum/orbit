{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun ../../scripts/vercel-install.ts",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "regions": ["hnd1"],
  "crons": [
    { "path": "/api/cron/analytics-snapshots", "schedule": "0 */6 * * *" },
    { "path": "/api/cron/notifications", "schedule": "* * * * *" },
    { "path": "/api/cron/prune", "schedule": "0 4 * * *" },
    { "path": "/api/cron/sprint-rollover", "schedule": "* * * * *" },
    { "path": "/api/cron/project-staleness", "schedule": "0 9 * * *" }
  ]
}
