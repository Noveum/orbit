{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbit",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "placement": { "region": "aws:us-east-1" },
  "limits": { "cpu_ms": 300000 },
  "observability": { "enabled": true },
  "vars": { "NODE_ENV": "production" },
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*",
      "!/logo.png",
      "!/og.png",
      "!/.well-known/mcp/server-card.json"
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "REALTIME_HUB", "class_name": "RealtimeHubObject" },
      { "name": "AUTH_RATE_LIMITER", "class_name": "AuthRateLimiterObject" },
      { "name": "DEFERRED_WORK", "class_name": "DeferredWorkObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RealtimeHubObject", "AuthRateLimiterObject"] },
    { "tag": "v2", "new_sqlite_classes": ["DeferredWorkObject"] }
  ],
  "triggers": {
    "crons": ["* * * * *", "0 * * * *", "0 */6 * * *", "0 9 * * *"]
  }
}
