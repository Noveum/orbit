{
  "name": "@orbit/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env next dev --port 3000",
    "build": "bun --env-file=../../.env ../../packages/db/src/check-drift.ts --guard-deploy && bun --env-file=../../.env next build && bun scripts/prepare-standalone.ts",
    "start": "node --env-file=../../.env .next/standalone/apps/web/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun --env-file=../../.env test tests --timeout 20000",
    "test:e2e": "bun --env-file=../../.env --bun playwright test",
    "build:workers": "bun --env-file=../../.env ../../packages/db/src/check-drift.ts --guard-deploy && ORBIT_WORKERS_BUILD=1 bun --env-file=../../.env vite build",
    "preview:workers": "wrangler dev --config dist/server/wrangler.json",
    "deploy:workers": "wrangler deploy --config dist/server/wrangler.json"
  },
  "imports": {
    "#argon2": {
      "workerd": "./src/lib/auth/argon2/portable.ts",
      "default": "./src/lib/auth/argon2/native.ts"
    }
  },
