{
  "name": "orbit",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Noveum/orbit.git"
  },
  "homepage": "https://orbit.noveum.ai",
  "bugs": {
    "url": "https://github.com/Noveum/orbit/issues"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild",
    "lefthook",
    "sharp"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "dev": "bun run --filter '*' dev",
    "typecheck": "tsc -p scripts/tsconfig.json --noEmit && bun run --filter '*' typecheck",
    "test": "bun test scripts && bun test ./tests/*.test.ts && bun run --filter '*' test",
    "test:e2e": "bun run --filter '@orbit/web' test:e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check-comments": "bun scripts/strip-comments.ts --check",
    "check-bytes": "bun scripts/check-source-bytes.ts",
    "check-deps": "bun scripts/check-dependency-dedupe.ts",
    "strip-comments": "bun scripts/strip-comments.ts",
    "verify": "bun run lint && bun run check-comments && bun run check-bytes && bun run check-bun-imports && bun run check-deps && bun run typecheck && bun run test",
    "backup:create": "bun scripts/backup/create.ts",
    "db:generate": "bun run --filter '@orbit/db' generate",
    "db:migrate": "bun run --filter '@orbit/db' migrate",
    "db:release": "bun run --filter '@orbit/db' release",
    "db:push": "bun run --filter '@orbit/db' push",
    "db:check-drift": "bun run --filter '@orbit/db' check-drift",
    "db:catchup": "bun run --filter '@orbit/db' catchup",
    "db:seed": "bun run --filter '@orbit/db' seed",
    "db:test-setup": "bun run --filter '@orbit/db' test-setup",
    "db:studio": "bun run --filter '@orbit/db' studio",
    "bench:outline": "bun apps/web/bench/outline-cost.ts",
    "labels:sync": "bun scripts/sync-labels.ts",
    "notifications:conversations-backfill": "bun scripts/notification-conversation-backfill.ts",
    "notifications:conversations-verify": "bun scripts/notification-conversation-verify.ts",
    "screenshots": "bun --env-file=.env apps/web/scripts/capture-screenshots.ts",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "prepare": "lefthook install || true",
    "db:test-lanes-drop": "bun run --filter '@orbit/db' test-lanes-drop",
    "check-bun-imports": "bun scripts/check-bun-imports.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "preview:init": "bun scripts/init-docker-preview.ts",
    "preview:tools": "docker compose --env-file .env.docker.local -f deploy/docker/compose.yaml build tools",
    "preview:infra": "docker compose --env-file .env.docker.local -f deploy/docker/compose.yaml up -d postgres redis storage",
    "preview:migrate": "docker compose --env-file .env.docker.local -f deploy/docker/compose.yaml run --rm tools bun run db:release",
    "preview:build": "docker compose --env-file .env.docker.local -f deploy/docker/compose.yaml run --rm tools bun scripts/export-docker-preview.ts && docker compose --env-file .env.docker.local -f deploy/docker/compose.yaml build web",
    "preview:up": "docker compose --env-file .env.docker.local -f deploy/docker/compose.yaml up -d web",
    "preview:down": "docker compose --env-file .env.docker.local -f deploy/docker/compose.yaml down",
    "preview:status": "docker compose --env-file .env.docker.local -f deploy/docker/compose.yaml ps",
    "preview:storage-check": "docker compose --env-file .env.docker.local -f deploy/docker/compose.yaml run --rm tools bun scripts/smoke-docker-storage.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@orbit/shared": "workspace:*",
    "@types/bun": "1.4.2",
    "lefthook": "2.1.14",
    "typescript": "5.9.3",
    "vitepress": "1.6.4"
  },
  "overrides": {
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3"
  }
}
